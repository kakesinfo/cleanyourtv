<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_quicksettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Transparent scrim for clicking outside to close -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Lateral Right Panel -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="195dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_quicksettings_sidebar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="20dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <!-- Top Header with Title and Clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:singleLine="true"
                android:text="@string/quick_settings_title"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextClock
                android:id="@+id/header_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="#20FFFFFF" />

        <!-- 1-Column Buttons -->
        <LinearLayout
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- 1. Image -->
            <LinearLayout
                android:id="@+id/row_picture"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/item_quicksettings_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_picture"
                    android:tint="@drawable/pill_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:text="@string/qs_picture_title"
                    android:textColor="@drawable/pill_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 2. Sortie Audio -->
            <LinearLayout
                android:id="@+id/row_audio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/item_quicksettings_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_audio"
                    android:tint="@drawable/pill_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:text="@string/qs_audio_title"
                    android:textColor="@drawable/pill_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 3. Wifi -->
            <LinearLayout
                android:id="@+id/row_wifi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/item_quicksettings_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_wifi"
                    android:tint="@drawable/pill_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:text="@string/qs_wifi_title"
                    android:textColor="@drawable/pill_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 4. Bluetooth -->
            <LinearLayout
                android:id="@+id/row_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/item_quicksettings_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_bluetooth"
                    android:tint="@drawable/pill_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:text="@string/qs_bluetooth_title"
                    android:textColor="@drawable/pill_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 5. Paramètres -->
            <LinearLayout
                android:id="@+id/row_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/item_quicksettings_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_settings"
                    android:tint="@drawable/pill_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:text="@string/qs_settings_title"
                    android:textColor="@drawable/pill_text"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
