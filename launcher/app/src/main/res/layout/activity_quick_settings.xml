<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_quicksettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Transparent scrim for clicking outside to close -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Lateral Right Vertical Icon Dock -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_quicksettings_sidebar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- 1. Image -->
        <FrameLayout
            android:id="@+id/row_picture"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/item_quicksettings_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/qs_picture_title">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_picture"
                android:tint="@drawable/pill_text" />
        </FrameLayout>

        <!-- 2. Sortie Audio -->
        <FrameLayout
            android:id="@+id/row_audio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/item_quicksettings_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/qs_audio_title">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_audio"
                android:tint="@drawable/pill_text" />
        </FrameLayout>

        <!-- 3. Wifi -->
        <FrameLayout
            android:id="@+id/row_wifi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/item_quicksettings_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/qs_wifi_title">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_wifi"
                android:tint="@drawable/pill_text" />
        </FrameLayout>

        <!-- 4. Bluetooth -->
        <FrameLayout
            android:id="@+id/row_bluetooth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/item_quicksettings_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/qs_bluetooth_title">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_bluetooth"
                android:tint="@drawable/pill_text" />
        </FrameLayout>

        <!-- 5. Paramètres -->
        <FrameLayout
            android:id="@+id/row_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/item_quicksettings_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/qs_settings_title">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_settings"
                android:tint="@drawable/pill_text" />
        </FrameLayout>

    </LinearLayout>
</RelativeLayout>
